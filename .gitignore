# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
ENV/

# Databases & local state (auto-created on startup)
database/*.db
database/*.duckdb
database/user_dbs/*.duckdb
!database/.gitkeep
!database/user_dbs/.gitkeep

# Subprocess temporary execution scripts
workspace/*/*.py
workspace/*/*.csv
workspace/*/*
!workspace/*/.gitkeep

# Backups & Logs
backups/*.zip
logs/*.log

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
